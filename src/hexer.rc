// Windows resources of hexer.exe.
// GLFW_ICON: the app icon. Named so GLFW uses it for the window/taskbar icon automatically, and as
// the first icon group in the exe it is also the icon Explorer shows. Generated by tools/make_icon.py.
GLFW_ICON ICON "hexer.ico"

// Application manifest (UTF-8 code page, DPI awareness).
// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST (numeric: no SDK header needed).
1 24 "hexer.manifest"
